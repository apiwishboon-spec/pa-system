{
  "name": "pa-system",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Offline school PA system: live announcements, bells, emergency alerts, background music and system-audio input.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "verify:media": "node scripts/verify-media.ts",
    "smoke": "npm run build && node scripts/smoke.mjs 8",
    "selftest": "npm run build && node scripts/selftest.mjs",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "electron-updater": "^6.8.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/auto-launch": "^5.0.5",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "th.school.pa",
    "productName": "PA System",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "media/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "PA-System-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Required to play audio from a line-in or virtual cable source into the PA.",
        "NSScreenCaptureUsageDescription": "Required to capture system audio from other applications into the PA."
      },
      "icon": "build/icon.icns"
    },
    "extraResources": [
      {
        "from": "build/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "build/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "apiwishboon-spec",
        "repo": "pa-system"
      }
    ]
  },
  "author": {
    "name": "Apiwish Anutaravanichkul",
    "url": "https://github.com/apiwishboon-spec"
  },
  "homepage": "https://github.com/apiwishboon-spec/pa-system",
  "license": "MIT"
}
